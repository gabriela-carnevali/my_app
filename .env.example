# PostgreSQL/PostGIS connection used by the backend
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transporte_escolar
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# Replace with a random secret containing at least 32 bytes.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Mapbox secret token used only by the backend
MAPBOX_ACCESS_TOKEN=replace-with-your-mapbox-token
